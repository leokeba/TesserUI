// Extending the interface with a custom element (DESIGN.md §9.8): the node
// serves <x-sun-dial> from flash, and hints draw a whole object with it, in
// the node's page and as a custom view page. Set WIFI_SSID / WIFI_PASSWORD,
// flash, then open http://<ip>/.
//
// The element's source is examples/elements/sun-dial.js; sun_dial.h embeds
// it (regenerated by `pnpm build` in web/). Any framework, or none, can
// write one: TesserUI sets its `value`, `schema` and `disabled` properties,
// and gives it a `tesser` handle to write values and call actions.
#include <TesserAPI.h>
#include <TesserUI.h>
#include <WiFi.h>

#include "sun_dial.h"

#ifndef WIFI_SSID
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"
#endif

tesser::Api api;
tesser::HttpServer http(api);
tesserui::WebUi web;

struct Tracker {
    double sunAz = 135, sunEl = 40;       // where the sun is
    double targetAz = 180, targetEl = 45;  // where the mirror points
} tracker;

void setup() {
    Serial.begin(115200);

    api.label("Heliostat");
    // The whole object is drawn by the element; without its script, the
    // interface falls back to plain rows of values.
    auto& sky = api.object("sky").label("Sky").ui("widget", "x-sun-dial");
    sky.value("sunAz", [] { return tracker.sunAz; }).unit("°").watch();
    sky.value("sunEl", [] { return tracker.sunEl; }).unit("°").watch();
    sky.value("targetAz", tracker.targetAz).range(0, 360).unit("°");
    sky.value("targetEl", tracker.targetEl).range(0, 90).unit("°");

    // A view whose only item is the element: a custom page, shown first.
    static tesserui::Views views(api);
    views.page("sky", "Sky").widget("x-sun-dial", "/sky");

    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    while (WiFi.status() != WL_CONNECTED) delay(200);
    Serial.printf("http://%s/\n", WiFi.localIP().toString().c_str());

    http.enableWebSocket("/ws");
    http.enableCors("https://leokeba.github.io");  // the launcher, reaching it by address
    http.begin(80, "/api");
    // tesser-sky.local, and listed by the launcher's bridge (DESIGN.md §9.7).
    http.advertise("tesser-sky", "tesser-sky");
    web.title("Heliostat")
        .theme("accent", "#d97706")
        .script("/ext/sun-dial.js")  // loaded by every page
        .asset("/ext/sun-dial.js", kSunDial, sizeof(kSunDial) - 1, "text/javascript");
    web.serve(http.handle(), "/api", "/ws");  // three handlers: page, bundle, element
    api.startTask();
}

void loop() {
    // The sun crosses the sky in two minutes.
    double day = fmod(millis() / 120000.0, 1.0);
    tracker.sunAz = 90.0 + 180.0 * day;
    tracker.sunEl = 60.0 * sin(3.14159265358979 * day);
    delay(50);
}
