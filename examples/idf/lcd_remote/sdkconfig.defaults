# The console's UART also carries API envelopes (a host script, or the
# launcher's USB way): log lines in the middle of a reply would break it.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Wi-Fi (for ESP-NOW), NowTP and LVGL: a 3 MB app on the board's 4 MB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The UI loop runs in app_main: LVGL, ArduinoJson and page building.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# LVGL: big-endian RGB565, what the panel takes over SPI.
CONFIG_LV_COLOR_FORMAT_RGB565_SWAPPED=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_USE_THORVG_INTERNAL=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# 1 ms ticks: the UI loop sleeps 5 ms between passes (at 100 Hz, 5 ms is 0 ticks).
CONFIG_FREERTOS_HZ=1000
