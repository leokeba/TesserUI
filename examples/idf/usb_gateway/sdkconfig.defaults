# The console's UART carries the envelopes: the launcher skips log lines, but
# one written in the middle of a reply would break it.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
# Wi-Fi (for ESP-NOW) outgrows the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
